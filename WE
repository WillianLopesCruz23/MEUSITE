<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Central de Iluminação IoT - Dashboard Arduino</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Paho MQTT Library CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              navy: '#0f172a',
              deepBlue: '#1e3a8a',
              sky: '#e0f2fe',
              ice: '#f8fafc',
              neonBlue: '#38bdf8',
              emerald: '#10b981',
              rose: '#f43f5e',
            }
          },
          animation: {
            'pulse-glow': 'pulseGlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'subtle-ping': 'ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite',
          },
          keyframes: {
            pulseGlow: {
              '0%, 100%': { 
                boxShadow: '0 0 25px rgba(56, 189, 248, 0.6), inset 0 0 15px rgba(255, 255, 255, 0.8)' 
              },
              '50%': { 
                boxShadow: '0 0 50px rgba(56, 189, 248, 0.95), inset 0 0 25px rgba(255, 255, 255, 0.9)' 
              },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Estilos Customizados para Glassmorphism e Efeitos */
    body {
      background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 40%, #ffffff 100%);
      min-height: 100vh;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .led-off {
      background: radial-gradient(circle, #cbd5e1 0%, #94a3b8 100%);
      box-shadow: inset 0 3px 6px rgba(0,0,0,0.2), 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .led-on {
      background: radial-gradient(circle, #ffffff 10%, #38bdf8 45%, #0284c7 100%);
    }

    /* Custom Scrollbar para o Console */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(241, 245, 249, 0.6);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="font-sans text-slate-800 flex items-center justify-center p-4 sm:p-6 md:p-8 antialiased">

  <!-- Container Principal -->
  <main class="w-full max-w-2xl mx-auto space-y-6">

    <!-- Card Glassmorphic Principal -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden transition-all">
      
      <!-- Cabeçalho -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200/60">
        <div class="flex items-center gap-3">
          <div class="p-3 bg-blue-600/10 text-blue-700 rounded-2xl flex items-center justify-center shadow-sm">
            <i data-lucide="cpu" class="w-7 h-7"></i>
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Central de Iluminação IoT</h1>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-blue-100/80 text-blue-800">
                Porta 13
              </span>
              <span class="text-xs text-slate-500 font-medium">Arduino / ESP32 Control</span>
            </div>
          </div>
        </div>

        <!-- Status de Conexão Inteligente (Pill Badge) -->
        <div id="statusPill" class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/80 shadow-sm transition-all duration-300 self-start sm:self-auto">
          <span class="relative flex h-2.5 w-2.5">
            <span id="statusPing" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span id="statusDot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
          </span>
          <span id="statusText">Sincronizando...</span>
        </div>
      </header>

      <!-- Campo de Configuração de Tópico MQTT -->
      <section class="mt-6">
        <label for="topicInput" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
          Tópico MQTT de Controle
        </label>
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="radio" class="w-4 h-4"></i>
          </div>
          <input 
            type="text" 
            id="topicInput" 
            value="gerry_sanchez_led_exclusivo/arduino"
            class="w-full pl-10 pr-24 py-2.5 bg-white/80 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all shadow-sm"
            placeholder="Digite o tópico MQTT..."
          />
          <button 
            id="btnUpdateTopic"
            onclick="atualizarTopico()"
            class="absolute right-1.5 px-3 py-1.5 bg-slate-900 text-white rounded-lg text-xs font-medium hover:bg-slate-800 active:scale-95 transition-all shadow-sm"
          >
            Atualizar
          </button>
        </div>
        <p id="topicFeedback" class="text-[11px] text-slate-500 mt-1.5 flex items-center gap-1 min-h-[16px]">
          <!-- Feedback em tempo real sobre a troca de tópico -->
        </p>
      </section>

      <!-- Área do Simulador do LED -->
      <section class="my-8 flex flex-col items-center justify-center">
        <div class="relative flex items-center justify-center p-8">
          
          <!-- Anel de Efeito Neon de Fundo para Estado Ligado -->
          <div id="ledGlowRing" class="absolute w-44 h-44 rounded-full opacity-0 transition-opacity duration-500 pointer-events-none"></div>

          <!-- Círculo do LED -->
          <div 
            id="ledVisual" 
            class="w-36 h-36 rounded-full led-off flex items-center justify-center transition-all duration-500 relative z-10 border-4 border-white/60 shadow-lg"
          >
            <i id="ledIcon" data-lucide="power" class="w-12 h-12 text-slate-100 transition-all duration-300"></i>
          </div>
        </div>

        <!-- Texto de Status do LED -->
        <div class="text-center mt-2">
          <span id="ledStatusBadge" class="text-sm font-bold tracking-wide uppercase px-4 py-1 rounded-full bg-slate-100 text-slate-500 border border-slate-200">
            Dispositivo Inativo
          </span>
          <p class="text-xs text-slate-400 mt-2">
            O estado reflete rigorosamente as confirmações do Broker MQTT
          </p>
        </div>
      </section>

      <!-- Botões de Ação de Toque Suave -->
      <section class="grid grid-cols-2 gap-4 pt-2">
        <button 
          id="btnLigar" 
          onclick="enviarComando('1')"
          disabled
          class="group flex items-center justify-center gap-2 py-3.5 px-6 bg-emerald-500 hover:bg-emerald-600 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed text-white font-semibold rounded-2xl shadow-md hover:shadow-lg active:scale-95 transition-all duration-200"
        >
          <i data-lucide="lightbulb" class="w-5 h-5 transition-transform group-hover:scale-110"></i>
          <span>LIGAR</span>
        </button>

        <button 
          id="btnDesligar" 
          onclick="enviarComando('0')"
          disabled
          class="group flex items-center justify-center gap-2 py-3.5 px-6 bg-slate-700 hover:bg-slate-800 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed text-white font-semibold rounded-2xl shadow-md hover:shadow-lg active:scale-95 transition-all duration-200"
        >
          <i data-lucide="power-off" class="w-5 h-5 transition-transform group-hover:scale-110"></i>
          <span>DESLIGAR</span>
        </button>
      </section>

      <!-- Console de Logs de Atividade (Apoio Pedagógico) -->
      <section class="mt-8 pt-6 border-t border-slate-200/60">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <i data-lucide="terminal" class="w-4 h-4 text-slate-500"></i>
            <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Console de Atividade MQTT</h2>
          </div>
          <button 
            onclick="limparLogs()"
            class="text-[11px] text-slate-400 hover:text-slate-600 transition-colors"
          >
            Limpar
          </button>
        </div>

        <div 
          id="consoleLogs" 
          class="h-32 bg-slate-900/90 rounded-2xl p-3 font-mono text-[11px] text-slate-300 overflow-y-auto custom-scrollbar space-y-1.5 shadow-inner border border-slate-800"
        >
          <div class="text-slate-500 flex items-center gap-1.5">
            <span class="text-blue-400">[SISTEMA]</span>
            <span>Inicializando cliente MQTT...</span>
          </div>
        </div>
      </section>

    </div>

    <!-- Rodapé Discreto -->
    <footer class="text-center text-xs text-slate-400">
      <p>Dashboard de Aprendizado IoT • Paho MQTT v1.0.1 • WebSockets SSL</p>
    </footer>

  </main>

  <script>
    // ==========================================
    // CONFIGURAÇÕES E VARIÁVEIS DE ESTADO
    // ==========================================
    const BROKER = "broker.hivemq.com";
    const PORTA = 8884; // WebSocket SSL
    
    // Client ID Dinâmico e Único
    const clientId = "web_client_" + Math.random().toString(16).substring(2, 10);
    
    let mqttClient = null;
    let topicoAtual = "gerry_sanchez_led_exclusivo/arduino";
    let isConnected = false;

    // Elementos do DOM
    const statusPill = document.getElementById("statusPill");
    const statusDot = document.getElementById("statusDot");
    const statusPing = document.getElementById("statusPing");
    const statusText = document.getElementById("statusText");
    const btnLigar = document.getElementById("btnLigar");
    const btnDesligar = document.getElementById("btnDesligar");
    const ledVisual = document.getElementById("ledVisual");
    const ledGlowRing = document.getElementById("ledGlowRing");
    const ledIcon = document.getElementById("ledIcon");
    const ledStatusBadge = document.getElementById("ledStatusBadge");
    const consoleLogs = document.getElementById("consoleLogs");
    const topicInput = document.getElementById("topicInput");
    const topicFeedback = document.getElementById("topicFeedback");

    // ==========================================
    // INICIALIZAÇÃO
    // ==========================================
    window.onload = function() {
      // Renderizar ícones da biblioteca Lucide
      lucide.createIcons();
      
      adicionarLog("SISTEMA", `ID de Cliente gerado: ${clientId}`);
      conectarMQTT();
    };

    // ==========================================
    // LÓGICA DE CONEXÃO PAHO MQTT
    // ==========================================
    function conectarMQTT() {
      atualizarStatusRede("conectando");
      adicionarLog("MQTT", `Conectando a wss://${BROKER}:${PORTA}...`);

      mqttClient = new Paho.MQTT.Client(BROKER, Number(PORTA), clientId);

      // Callbacks do Cliente
      mqttClient.onConnectionLost = aoPerderConexao;
      mqttClient.onMessageArrived = aoChegarMensagem;

      // Opções de Conexão com SSL ativado
      const options = {
        useSSL: true,
        timeout: 10,
        onSuccess: aoConectarSucesso,
        onFailure: aoFalharConexao
      };

      try {
        mqttClient.connect(options);
      } catch (err) {
        adicionarLog("ERRO", `Exceção ao conectar: ${err.message}`);
        atualizarStatusRede("erro");
      }
    }

    // Callback de Sucesso na Conexão
    function aoConectarSucesso() {
      isConnected = true;
      atualizarStatusRede("online");
      adicionarLog("MQTT", "Conexão estabelecida com sucesso!");

      // Inscrever no tópico inicial
      assinarTopico(topicoAtual);
    }

    // Callback de Falha na Conexão
    function aoFalharConexao(responseObject) {
      isConnected = false;
      atualizarStatusRede("erro");
      adicionarLog("ERRO", `Falha ao conectar: ${responseObject.errorMessage}`);
    }

    // Callback de Perda de Conexão
    function aoPerderConexao(responseObject) {
      isConnected = false;
      atualizarStatusRede("erro");
      if (responseObject.errorCode !== 0) {
        adicionarLog("ERRO", `Conexão perdida: ${responseObject.errorMessage}`);
      }
    }

    // ==========================================
    // REGRA DE OURO: CALLBACK DE MENSAGEM RECEBIDA
    // ==========================================
    // A cor e o estado do LED virtual na tela NUNCA mudam no clique do botão.
    // O LED só muda AQUI, quando o Broker envia a confirmação/mensagem.
    function aoChegarMensagem(message) {
      const payload = message.payloadString.trim();
      adicionarLog("NUVEM", `Mensagem recebida no tópico [${message.destinationName}]: '${payload}'`);

      if (payload === "1") {
        ativarLedVisual(true);
      } else if (payload === "0") {
        ativarLedVisual(false);
      } else {
        adicionarLog("AVISO", `Valor desconhecido recebido: '${payload}' (Esperado: '1' ou '0')`);
      }
    }

    // ==========================================
    // FUNÇÕES DE AÇÃO E ENVIO DE COMANDOS
    // ==========================================
    function enviarComando(valor) {
      if (!isConnected || !mqttClient) {
        adicionarLog("ERRO", "Impossível enviar: Cliente desconectado do broker.");
        return;
      }

      try {
        const message = new Paho.MQTT.Message(valor);
        message.destinationName = topicoAtual;
        mqttClient.send(message);
        
        adicionarLog("ENVIADO", `Publicado '${valor}' no tópico '${topicoAtual}'`);
      } catch (err) {
        adicionarLog("ERRO", `Falha ao publicar mensagem: ${err.message}`);
      }
    }

    // ==========================================
    // GERENCIAMENTO DINÂMICO DE TÓPICOS
    // ==========================================
    function assinarTopico(topico) {
      if (!isConnected) return;

      try {
        mqttClient.subscribe(topico);
        adicionarLog("SUBSCRIÇÃO", `Inscrito no tópico: ${topico}`);
        topicFeedback.innerHTML = `<span class="text-emerald-600 font-medium">✓ Inscrito no tópico: ${topico}</span>`;
      } catch (err) {
        adicionarLog("ERRO", `Falha ao inscrever no tópico: ${err.message}`);
      }
    }

    function atualizarTopico() {
      const novoTopico = topicInput.value.trim();

      if (!novoTopico) {
        topicFeedback.innerHTML = `<span class="text-rose-500 font-medium">⚠️ Por favor, informe um tópico válido.</span>`;
        return;
      }

      if (novoTopico === topicoAtual) {
        topicFeedback.innerHTML = `<span class="text-slate-400">Tópico inalterado.</span>`;
        return;
      }

      if (isConnected) {
        // Desinscrever do tópico antigo
        try {
          mqttClient.unsubscribe(topicoAtual);
          adicionarLog("SUBSCRIÇÃO", `Cancelada inscrição do tópico: ${topicoAtual}`);
        } catch (e) {
          console.error(e);
        }

        // Atualizar variável e inscrever no novo
        topicoAtual = novoTopico;
        assinarTopico(topicoAtual);
      } else {
        topicoAtual = novoTopico;
        topicFeedback.innerHTML = `<span class="text-amber-600 font-medium">Tópico salvo. Será inscrito ao conectar.</span>`;
      }
    }

    // ==========================================
    // ATUALIZAÇÕES VISUAIS DA INTERFACE
    // ==========================================
    function ativarLedVisual(ligado) {
      if (ligado) {
        // Estado LIGADO (1): Neon Ciano / Azul Elétrico Radiante
        ledVisual.className = "w-36 h-36 rounded-full led-on flex items-center justify-center transition-all duration-500 relative z-10 border-4 border-cyan-100 animate-pulse-glow";
        ledGlowRing.className = "absolute w-48 h-48 rounded-full bg-sky-400/30 blur-2xl opacity-100 transition-opacity duration-500 pointer-events-none";
        
        ledIcon.className = "w-12 h-12 text-white transition-all duration-300 drop-shadow-[0_0_10px_rgba(255,255,255,0.9)]";
        
        ledStatusBadge.className = "text-sm font-bold tracking-wide uppercase px-4 py-1 rounded-full bg-sky-100 text-sky-700 border border-sky-300/60 shadow-sm";
        ledStatusBadge.innerText = "Dispositivo Ativo (ON)";
      } else {
        // Estado DESLIGADO (0): Cinza Azulado Fosco
        ledVisual.className = "w-36 h-36 rounded-full led-off flex items-center justify-center transition-all duration-500 relative z-10 border-4 border-white/60 shadow-lg";
        ledGlowRing.className = "absolute w-48 h-48 rounded-full opacity-0 transition-opacity duration-500 pointer-events-none";
        
        ledIcon.className = "w-12 h-12 text-slate-100 transition-all duration-300";
        
        ledStatusBadge.className = "text-sm font-bold tracking-wide uppercase px-4 py-1 rounded-full bg-slate-100 text-slate-500 border border-slate-200";
        ledStatusBadge.innerText = "Dispositivo Inativo (OFF)";
      }
    }

    function atualizarStatusRede(estado) {
      if (estado === "online") {
        statusPill.className = "inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-sm transition-all duration-300";
        statusDot.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500";
        statusPing.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
        statusText.innerText = "Sistema Online";

        // Habilitar Botões de Ação
        btnLigar.disabled = false;
        btnDesligar.disabled = false;

      } else if (estado === "conectando") {
        statusPill.className = "inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/80 shadow-sm transition-all duration-300";
        statusDot.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500";
        statusPing.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75";
        statusText.innerText = "Sincronizando...";

        // Desabilitar Botões de Ação
        btnLigar.disabled = true;
        btnDesligar.disabled = true;

      } else { // Erro / Desconectado
        statusPill.className = "inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200/80 shadow-sm transition-all duration-300";
        statusDot.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500";
        statusPing.className = "hidden";
        statusText.innerText = "Conexão Perdida";

        // Desabilitar Botões de Ação
        btnLigar.disabled = true;
        btnDesligar.disabled = true;
      }
    }

    // ==========================================
    // SISTEMA DE CONSOLE / LOGS
    // ==========================================
    function adicionarLog(tag, mensagem) {
      const agora = new Date();
      const timeStr = agora.toTimeString().split(' ')[0] + '.' + String(agora.getMilliseconds()).padStart(3, '0');
      
      let tagColor = "text-slate-400";
      if (tag === "NUVEM") tagColor = "text-sky-400 font-bold";
      if (tag === "ENVIADO") tagColor = "text-emerald-400 font-bold";
      if (tag === "ERRO") tagColor = "text-rose-400 font-bold";
      if (tag === "SUBSCRIÇÃO") tagColor = "text-amber-400";
      if (tag === "MQTT") tagColor = "text-indigo-400";

      const logItem = document.createElement("div");
      logItem.className = "flex items-start gap-2 leading-relaxed border-b border-slate-800/40 pb-1";
      logItem.innerHTML = `
        <span class="text-slate-500 shrink-0">[${timeStr}]</span>
        <span class="${tagColor} shrink-0">[${tag}]</span>
        <span class="text-slate-300 break-all">${escapeHtml(mensagem)}</span>
      `;

      consoleLogs.appendChild(logItem);
      // Rolar automaticamente para o último log
      consoleLogs.scrollTop = consoleLogs.scrollHeight;
    }

    function limparLogs() {
      consoleLogs.innerHTML = "";
      adicionarLog("SISTEMA", "Console de logs limpo.");
    }

    function escapeHtml(text) {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
